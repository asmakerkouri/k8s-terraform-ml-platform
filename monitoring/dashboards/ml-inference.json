{
  "title": "ML inference service",
  "uid": "ml-inference",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries", "title": "Requests / s", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(rate(inference_requests_total[1m])) by (status)", "legendFormat": "{{status}}" }]
    },
    {
      "type": "timeseries", "title": "Inference latency p50 / p95 (s)", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(inference_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(inference_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "type": "timeseries", "title": "Detections / s by label", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(rate(detections_total[5m])) by (label)", "legendFormat": "{{label}}" }]
    },
    {
      "type": "stat", "title": "Running pods", "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "count(up{service=~\".*ml-inference.*\"} == 1)" }]
    }
  ]
}
